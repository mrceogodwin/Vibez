# Copy to .env.local. Never commit real secrets.
# The Vercel project already has DATABASE_URL (production, pooled) and BACHS_SECRET_KEY.
# Local and preview work must use a Neon branch, not the production endpoint
# ep-soft-wind-zam8gd6x, unless an additive production migration has been approved.

DATABASE_URL=
SESSION_PEPPER=
SUPER_ADMIN_EMAILS=

PAYMENT_PROVIDER=bachs
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# Set to true only when this environment is allowed to create live Bachs checkouts.
BACHS_ALLOW_LIVE=

# Optional fallback. Leave unset until Paystack should be selectable.
PAYSTACK_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

RESEND_API_KEY=
EMAIL_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Native clients. Web uses the same origin.
EXPO_PUBLIC_API_URL=
