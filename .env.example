# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Bachs billing (add only after creating keys in the Bachs developer dashboard)
# Keep secret keys server-side only; use sandbox credentials during integration tests.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_ENV=sandbox

# Broadcast provider credentials will be added after selecting and provisioning the streaming service.
