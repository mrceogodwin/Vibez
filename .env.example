# Copy to .env.local for `npm run dev`. Never commit real secrets.
# The Vercel project `vibez` should set the same keys for production.
# Missing keys must not crash the app. Each screen explains what is not configured.

# Postgres (Neon). The build runs migrations when this is set.
DATABASE_URL=

# Better Auth. The deployer sets VITE_AUTH_ENABLED=true in production.
# Leave it false locally to use the preview dev user.
VITE_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=

# Existing Grok auth broker (Google and X sign-in when the broker is provisioned).
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Email codes (Resend). Without RESEND_API_KEY the verify and reset screens show the one-time code.
RESEND_API_KEY=
EMAIL_FROM=
AUTH_CODE_PEPPER=

# Paystack. Without PAYSTACK_SECRET_KEY, paid checkout explains that payments are not configured and issues no tickets.
PAYSTACK_SECRET_KEY=
# Optional public key if a future client widget needs it. The server never sends the secret to the browser.
PAYSTACK_PUBLIC_KEY=

# Comma-separated emails that become Control Room super admins on sign-in.
VIBEZ_ADMIN_EMAILS=

# Optional object storage. Without it, artwork is a pasted URL.
BLOB_READ_WRITE_TOKEN=
